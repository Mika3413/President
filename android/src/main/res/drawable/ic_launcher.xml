    <item android:width="48dp" android:height="48dp" android:gravity="center">
        <shape android:shape="rectangle"><solid android:color="#16202B" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:width="12dp" android:height="28dp" android:gravity="center" android:left="-24dp">
        <shape android:shape="rectangle"><solid android:color="#2A5F93" /></shape>
    </item>
    <item android:width="12dp" android:height="28dp" android:gravity="center">
        <shape android:shape="rectangle"><solid android:color="#E8EDF2" /></shape>
    </item>
    <item android:width="12dp" android:height="28dp" android:gravity="center" android:left="24dp">
        <shape android:shape="rectangle"><solid android:color="#E05A4F" /></shape>
    </item>
</layer-list>
